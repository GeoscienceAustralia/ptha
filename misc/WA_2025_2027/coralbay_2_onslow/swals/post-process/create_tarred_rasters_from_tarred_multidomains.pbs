#!/bin/bash
#PBS -P w85
#PBS -q normal
#PBS -l walltime=48:00:00
#PBS -l mem=190GB
#PBS -l ncpus=48
#PBS -l jobfs=50GB
#PBS -l wd
#PBS -l storage=scratch/w85+gdata/w85

. ../../modules_R_431.sh 


# Split the work into this many separate jobs. Helps stop R accumulating memory and failing.
NRUNS=50

for i in $(eval echo "{1..$NRUNS}")
do
    Rscript create_tarred_rasters_from_tarred_multidomains.R "../OUTPUTS/ptha18-coralbay2onslow-hazard/random_*/ptha18_random_scenarios_*/RUN_*.tar" $i $NRUNS
done
