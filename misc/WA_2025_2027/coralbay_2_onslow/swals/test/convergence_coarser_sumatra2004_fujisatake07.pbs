#!/bin/bash
#PBS -P w85
#PBS -q normalsr
#PBS -l walltime=4:00:00
#PBS -l mem=1000GB
#PBS -l ncpus=208
#PBS -l wd
#PBS -l storage=scratch/w85+gdata/w85

source ../modules_ifx_2025_llvm.sh

stage_file=../sources/like_historic/sumatra2004/FujiSatake2007/FujiSatake2007_time_varying_forcing_realistic.csv

multidomain_design_namelist=./multidomain_design_control/convergence_double-dx.nml

model_name=test/convergence/coarser_sumatra2004_fujisatake07_timevarying

ambient_sea_level=0

# Run the model
mpiexec -n 16 -map-by numa:SPAN -bind-to numa -x OMP_NUM_THREADS=13 -x OMP_PROC_BIND=true \
    ./model_build \
    $stage_file \
    $multidomain_design_namelist \
    $model_name \
    full \
    $ambient_sea_level > outfile.log
